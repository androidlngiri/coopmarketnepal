# Application URL
APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Supabase PostgreSQL, Auth & Storage
# Found in Supabase Dashboard -> Project Settings -> Data API (Project URL)
# and Project Settings -> API Keys (Publishable / anon, and Secret / service_role)
SUPABASE_URL="https://your-project.supabase.co"
VITE_SUPABASE_URL="https://your-project.supabase.co"
VITE_SUPABASE_ANON_KEY="your-publishable-or-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-secret-or-service-role-key"
# Optional aliases also supported:
# VITE_SUPABASE_PUBLISHABLE_KEY="sb_publishable_..."
# SUPABASE_SECRET_KEY="sb_secret_..."
# NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
# NEXT_PUBLIC_SUPABASE_ANON_KEY="your-publishable-or-anon-key"

# Akash SMS Server-Side Integration (Nepal - v3 API)
# Found in AakashSMS Dashboard -> API Services -> Token
AAKASH_SMS_ENDPOINT="https://sms.aakashsms.com/sms/v3/send"
AAKASH_SMS_AUTH_TOKEN="your-aakash-sms-auth-token"
# Optional aliases also supported:
# AKASH_SMS_API_URL="https://sms.aakashsms.com/sms/v3/send"
# AKASH_SMS_API_KEY="your-aakash-sms-auth-token"

# Security
SESSION_SECRET="change-this-to-a-long-random-secret-in-production"
SUPER_ADMIN_BOOTSTRAP_SECRET=""
